# Copy to ".env" (ignored by git) and fill in. See docs/contributing/setup.md.

# A directory OUTSIDE this repository, in an encrypted area. It has to exist; Zweigerl does not create it.
ZWEIGERL_DATA_DIR=/path/to/encrypted/zweigerl-daten

# Generate one with:
#   uv run python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
